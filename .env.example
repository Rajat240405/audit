# INCOIS Audit Pro
# Environment variables — copy to .env and fill in values

# LLM generation timeout in seconds (default 300 = 5 minutes).
# Local models (e.g. Qwen 3 8B via Ollama on CPU) can take several minutes to
# generate a full answer; raise this if generation is cut off mid-response.
#LLM_TIMEOUT_SECONDS=300

# ── Ollama endpoint (PC) ─────────────────────────────────────────────────
# ONE resolver drives every Ollama code path (health checks, /api/models
# discovery, generation, streaming, GraphRAG extraction):
#   1. OLLAMA_BASE_URL — full URL, e.g. http://127.0.0.1:12000
#   2. OLLAMA_HOST     — upstream-style host[:port] (scheme added; a
#                        wildcard like 0.0.0.0:12000 becomes 127.0.0.1:12000)
#   3. fallback        — http://localhost:11434
# WINDOWS PORT NOTE: if Ollama fails with "bind: An attempt was made to
# access a socket in a way forbidden by its access permissions" while
# netstat shows nothing on the port, the port is inside an excluded range
# (check: netsh interface ipv4 show excludedportrange protocol=tcp —
# e.g. 11401–11500 swallows 11434). Serve Ollama on a free port instead
# (OLLAMA_HOST=127.0.0.1:12000 ollama serve) and mirror it here:
#OLLAMA_BASE_URL=http://127.0.0.1:12000

# ── Enabled providers (deployment boundary: PC vs HPC) ───────────────────
# Comma-separated list of providers THIS deployment exposes. Default: just
# the one derived from the environment (ollama on PC; vllm when
# VLLM_BASE_URL / APP_DEFAULT_PROVIDER=vllm is set — e.g. HPC).
# Both the UI and the backend enforce it: /api/providers returns only these,
# and /api/provider + /api/models reject any other provider (403).
# Model names are always DISCOVERED from the connected server
# (Ollama /api/tags, vLLM /v1/models) — config/models.yaml only supplies
# metadata (context window, thinking capability, think_mode) for known ids;
# it is never treated as proof a model is installed or served.
#APP_PROVIDERS=ollama

# ── Offline / HPC model paths ──────────────────────────────────────────────
# Embedding + reranker models can be local folders (copy the HF model dirs
# from the machine that has them, e.g. sir's models/bge-m3). If unset, the
# pipeline auto-detects a local ./models/bge-m3 (or ./models/bge-reranker-v2-m3)
# folder, else falls back to downloading from HuggingFace (needs internet).
#GRAPHRAG_EMBED_MODEL=C:/path/to/models/bge-m3
#GRAPHRAG_RERANK_MODEL=C:/path/to/models/bge-reranker-v2-m3
# Force CUDA on HPC (default is auto-detect):
#GRAPHRAG_EMBEDDING_DEVICE=cuda

# ── HPC / container runtime (Singularity) ──────────────────────────────────
# Path override for the HuggingFace in-container LLM (Qwen3.5-35B-A3B GGUF).
# The container binds the model directory; the provider resolves this env var.
#GRAPHRAG_MODEL_PATH=/models/Qwen3.5-35B-A3B/Qwen3.5-35B-A3B-Q4_K_M.gguf

# ── vLLM (HPC; first smoke test is still single-user / single-worker) ─────
# The app process is an HTTP client of a SEPARATE vLLM server. It does not
# load Qwen weights and does not require CUDA in the app container.
# Same code on Windows: leave these unset or set APP_DEFAULT_PROVIDER=ollama.
#
# Windows / PC (native process, Ollama on the same machine):
#   APP_DEFAULT_PROVIDER=ollama
#
# Windows Docker app container (Ollama stays on the host):
#   APP_DEFAULT_PROVIDER=vllm
#   VLLM_BASE_URL=http://host.docker.internal:11434/v1
#   VLLM_MODEL=qwen3:8b
#   APP_MODE=serve
#
# HPC (vLLM already running on the host, e.g. port 8001/8100):
#   APP_DEFAULT_PROVIDER=vllm
#   VLLM_BASE_URL=http://localhost:8001
#   APP_MODE=serve
# VLLM_MODEL is OPTIONAL: when unset, the app queries vLLM's /v1/models at
# boot, uses the currently-served model id verbatim on the wire, resolves it
# against the catalog by EXACT name (known models keep their capability
# metadata), and registers a conservative dynamic family for unknown models
# (metadata flagged server/fallback; thinking capability stays UNKNOWN, no
# thinking control is sent). Set VLLM_MODEL only to intentionally pin a
# specific served id (useful for local testing).
# Discovery is TTL-cached (VLLM_DISCOVERY_TTL_SECONDS, default 300) and
# refreshed automatically; POST /api/models/refresh forces re-discovery.
#
# The vLLM server on HPC is launched per config/models.yaml (serving specs).
# Current A40 limits (raised 2026-08-19 — the 32K bottleneck was deployment
# config, not a model constraint):
#   Qwen3.8-27B-FP8   --max-model-len 131072   (native 262144; 2 fp8-KV seqs fit)
#   Qwen3.6-35B-A3B-FP8 --max-model-len 65536  (A40 VRAM-tight at fp16 KV)
# Example:
#   vllm serve /models/Qwen3.8-27B-FP8 \
#     --host 127.0.0.1 --port 8100 \
#     --served-model-name Qwen3.8-27B-FP8 \
#     --max-model-len 131072 \
#     --max-num-seqs 2 \
#     --gpu-memory-utilization 0.90 \
#     --kv-cache-dtype fp8 \
#     --enable-auto-tool-choice \
#     --tool-call-parser qwen3_coder
# The reasoning parser (qwen3) keeps CoT out of the answer text; without it
# the app still surfaces thinking via inline <think> extraction.
# Thinking itself is toggled per request by the app via
# chat_template_kwargs.enable_thinking (Standard=false / Deep=true) — the model
# name is never suffixed with /think or /nothink.
#
# To let the app actually USE the larger serving window, raise its safety
# ceiling on the HPC (else the catalogue context_window stays the cap):
#   RAG_MAX_CONTEXT_TOKENS=131072   (Qwen3.8 host)
#   RAG_MAX_CONTEXT_TOKENS=65536    (Qwen3.6 host)
#
# VLLM_BASE_URL may be http://localhost:8001 or http://localhost:8001/v1 —
# the OpenAI adapter joins /v1/chat/completions without doubling /v1.
#VLLM_BASE_URL=http://localhost:8001
# VLLM_MODEL: optional pin — unset = dynamic discovery of the served model.
#VLLM_MODEL=
#VLLM_DISCOVERY_TTL_SECONDS=300
# RAG_MAX_CONTEXT_TOKENS: application-side context SAFETY CEILING (optional).
# Effective runtime context = min(model native context, vLLM serving
# --max-model-len, this ceiling). Unset = the catalogue context_window of the
# active model (today's behavior). Set to allow larger evidence budgets when
# the model/server support them — no code change needed to raise it later.
# Example: model native 262144, vLLM 131072, RAG_MAX_CONTEXT_TOKENS=65536
#          -> effective context 65536.
#RAG_MAX_CONTEXT_TOKENS=65536
#APP_DEFAULT_PROVIDER=ollama

# ── Runtime / startup mode (Phase 4) ────────────────────────────────────────
# Selected by the launcher: python -m src.scripts.startup [--port N]
#
#   APP_MODE=serve   STARTUP WITHOUT INGEST: no ingestion, no index rebuild,
#                    no embeddings, no corpus writes, no model downloads at
#                    boot. The existing corpus/indexes are used exactly as
#                    saved (loaded lazily on first request). The ingest/upload
#                    APIs stay blocked (403) — read-only serving.
#
#   APP_MODE=ingest  STARTUP WITH INGEST: BEFORE the server binds a port, run
#   (or "build")     the existing Phase-2/3 pipeline over all sources
#                    (same as `python -m src.scripts.ingest all --ingest`):
#                    discover → extract → append-only corpus → embed ONLY
#                    genuinely new records → update FAISS/BM25 → then serve
#                    (mutation APIs enabled, as before).
#                    · nothing new  → zero index work, serve
#                    · no index yet → first full build (the only implicit
#                      full rebuild; afterwards always incremental)
#                    · incremental update FAILED → startup exits 3 loudly and
#                      does NOT serve; NEVER an automatic full-rebuild
#                      fallback. Corpus intact (append-only), index untouched.
#
# unset/unknown values are SAFE: startup without ingest (the API gate keeps
# its pre-Phase-4 semantics for the literal value). The launcher also keeps a
# PID guard (<storage>/app.pid): refuse duplicates (exit 2), auto-recover
# from stale files after a crash, remove it on clean shutdown.
#
# HPC pattern: the always-on container runs APP_MODE=serve; ingest as a
# one-shot job (`python -m src.scripts.ingest all --ingest`) with the serving
# container stopped or via its UI — then restart the serve container so the
# lazy pipeline picks up the updated index from disk. For a single combined
# deployment, APP_MODE=ingest does ingest-then-serve in one process.
#APP_MODE=serve

# ── Uvicorn ────────────────────────────────────────────────────────────────
# First Docker → Singularity → HPC smoke test: ONE worker only.
# Do not start with --workers N (N>1). Globals (ACTIVE_CONFIG / llm_client)
# are not multi-process safe. start_server() passes workers=1.

# ── CORS ───────────────────────────────────────────────────────────────────
# Not enabled. FastAPI serves frontend/dist at the same origin. Do not add
# CORS unless the UI is hosted on a different origin than /api.

# ── Filesystem roots (P0.3) — sufficient for planned bind mounts ───────────
# Leave unset on Windows/dev: <repo>/data, <repo>/storage/hybrid_rag, <repo>/models.
# Planned Singularity/Docker binds (app process CWD is never used):
#   APP_DATA_DIR  -> /data              corpus, inbox, user-knowledge, prompt debug
#   APP_INDEX_DIR -> /storage/hybrid_rag
#   APP_MODEL_DIR -> /models            bge-m3 + reranker ONLY — not Qwen/vLLM weights
#APP_DATA_DIR=/data
#APP_INDEX_DIR=/storage/hybrid_rag
#APP_MODEL_DIR=/models
# Local identity stamped on Save-to-Knowledge (no SSO). Also accepts X-User header.
#APP_USER=your-name

# Save-to-Knowledge fuzzy match (difflib ratio). Default 0.85 (documented).
# Lower only if you want looser matches; range 0..1.
#KNOWLEDGE_FUZZY_THRESHOLD=0.85

