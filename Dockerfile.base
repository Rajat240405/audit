FROM node:22-bookworm-slim AS frontend-base
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# ── Base app image (deps only) ────────────────────────────────────────────
FROM python:3.12-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models/hf-cache \
    TRANSFORMERS_CACHE=/models/hf-cache \
    APP_DATA_DIR=/data \
    APP_INDEX_DIR=/storage/hybrid_rag \
    APP_MODEL_DIR=/models \
    APP_MODE=serve \
    PICODET_MODEL_DIR=/models/PicoDet_layout_1x_table \
    PADDLE_PDX_CACHE_HOME=/models/paddlex-cache

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        libgomp1 \
        libglib2.0-0 \
        libgl1 \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-hin \
    && rm -rf /var/lib/apt/lists/*

# GPU torch (CUDA 12.4 wheels) — pinned for reproducible SIF builds (#6).
# Index artifacts (FAISS binary / BM25 pickle / embeddings) are only
# guaranteed compatible with the versions that built them; bump deliberately.
RUN pip install --index-url https://download.pytorch.org/whl/cu124 \
        torch==2.6.0 \
    && pip install \
        "httpx>=0.27.0" \
        "beautifulsoup4>=4.12.0" \
        "lxml>=5.0.0" \
        "pydantic>=2.7.0" \
        "pydantic-settings>=2.3.0" \
        "pyyaml>=6.0.0" \
        "rich>=13.7.0" \
        "tqdm>=4.66.0" \
        "click>=8.1.0" \
        "fastapi>=0.110.0" \
        "uvicorn>=0.28.0" \
        "orjson>=3.10.0" \
        "numpy>=1.24.0" \
        "pandas>=2.0.0" \
        "networkx>=3.0.0" \
        "neo4j>=5.14.0" \
        "faiss-cpu==1.15.0" \
        "sentence-transformers>=3.0.0" \
        "rank-bm25==0.2.2" \
        "pypdf>=5.0.0" \
        "python-docx>=1.1.0" \
        "PyMuPDF>=1.24.0" \
        "pytesseract>=0.3.10"
# NOTE: opencv is deliberately NOT installed here. It is installed by the
# cv2-normalisation layer below, after paddleocr, because paddleocr pulls a
# conflicting GUI build. Installing it here as well would only be overwritten.

# ── PicoDet table detector (CPU) ─────────────────────────────────────────
# paddlepaddle is PINNED to 3.2.2. DO NOT BUMP TO 3.3.x.
#
# On 3.3.x the first CPU inference raises, on Linux x86-64:
#     NotImplementedError: ConvertPirAttribute2RuntimeAttribute not support
#     [pir::ArrayAttribute<pir::DoubleAttribute>]  (onednn_instruction.cc:116)
# The PIR->runtime attribute converter has branches for
# ArrayAttribute<Int32/Int64/Float> but none for DoubleAttribute (Paddle
# issue #79749). PaddleOCR sets enable_mkldnn=True by default, so oneDNN is
# active by default and CPU inference is broken out of the box on 3.3.x.
# Verified by reproduction on Linux — this is NOT Windows-specific, and the
# commonly cited FLAGS_enable_pir_api=0 workaround does NOT fix it.
#
# We pin instead of forcing enable_mkldnn=False because disabling oneDNN is
# 2.3x slower (measured: 296 ms/page on 3.2.2 with oneDNN vs 678 ms without).
# Escape hatch if 3.3.x ever becomes unavoidable: set the environment
# variable PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0 at runtime. No code change.
RUN pip install \
        "paddlepaddle==3.2.2" \
        "paddleocr==3.7.0"

# ── cv2 normalisation (MUST stay after paddleocr) ────────────────────────
# PaddleOCR/PaddleX expect the `opencv-contrib-python` distribution.
# We intentionally install the full contrib package here because
# PaddleX 3.7.x checks for that distribution when constructing its
# PDFReaderBackend.
#
# Keep this AFTER paddleocr installation because paddleocr pulls its own
# OpenCV variant transitively. All OpenCV variants share the same `cv2`
# package, so remove every variant first, then install exactly one package.
#
# Full opencv-contrib-python requires the basic GL/Glib runtime libraries
# installed above (`libgl1`, `libglib2.0-0`).
RUN pip uninstall -y opencv-python opencv-contrib-python \
                    opencv-python-headless opencv-contrib-python-headless \
 && pip install --no-cache-dir "opencv-contrib-python==5.0.0.93"

# Fail the BUILD, not the first PDF of the nightly run, if the above did not
# hold: imports must succeed, paddle must be the pinned version, and the cv2
# shared object must not link libGL.
# Fail the BUILD, not the first PDF of the run, if the core runtime is wrong.
RUN python -c "import cv2, paddle, paddleocr, importlib.metadata as md; \
assert paddle.__version__ == '3.2.2', 'paddle must be 3.2.2, got ' + paddle.__version__; \
assert paddleocr.__version__ == '3.7.0', 'paddleocr must be 3.7.0, got ' + paddleocr.__version__; \
assert md.version('opencv-contrib-python') == '5.0.0.93', 'opencv-contrib-python must be 5.0.0.93'; \
print('OK cv2', cv2.__version__, '| paddle', paddle.__version__, '| paddleocr', paddleocr.__version__, '| opencv-contrib-python', md.version('opencv-contrib-python'))"

RUN mkdir -p /data /storage/hybrid_rag /storage/graphrag /models /models/hf-cache \
             /models/paddlex-cache