diff --git a/frontend/src/components/layout/SessionMenu.tsx b/frontend/src/components/layout/SessionMenu.tsx
new file mode 100644
index 0000000..37c70a8
--- /dev/null
+++ b/frontend/src/components/layout/SessionMenu.tsx
@@ -0,0 +1,73 @@
+/**
+ * Header account chip: who is signed in, and a way to sign out.
+ *
+ * Phase 3 signs you IN. It does not lock anything DOWN — this control reports
+ * session state and offers sign-out; it gates nothing. Existing routes stay
+ * reachable without a session until Phase 4.
+ */
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import { LogIn, LogOut, User as UserIcon } from "lucide-react";
+import { Link } from "react-router-dom";
+import { Button } from "@/components/ui/button";
+import { fetchSession, signOut } from "@/api/auth";
+
+export function SessionMenu() {
+  const queryClient = useQueryClient();
+
+  const { data } = useQuery({
+    queryKey: ["session"],
+    queryFn: fetchSession,
+    // Short-lived: this is chrome, not data. Never retry a 401 — fetchSession
+    // already turns that into "signed out", so a retry would just be noise.
+    staleTime: 60_000,
+    refetchOnWindowFocus: false,
+  });
+
+  const signedIn = Boolean(data?.authenticated);
+  const email = data?.user?.email ?? null;
+
+  const handleSignOut = async () => {
+    await signOut();
+    // Drop the cached session so the header re-renders immediately.
+    queryClient.setQueryData(["session"], { authenticated: false, user: null });
+    queryClient.invalidateQueries({ queryKey: ["session"] });
+  };
+
+  if (!signedIn) {
+    return (
+      <Link
+        to="/signin"
+        title="Sign in"
+        aria-label="Sign in"
+        data-testid="session-signin"
+        className="inline-flex h-8 w-8 items-center justify-center rounded-md text-muted transition-colors hover:bg-surface-2 hover:text-foreground"
+      >
+        <LogIn className="h-4 w-4" />
+      </Link>
+    );
+  }
+
+  return (
+    <div className="flex items-center gap-1" data-testid="session-menu">
+      <span
+        className="hidden max-w-[180px] truncate text-xs text-muted lg:inline"
+        title={email ?? undefined}
+      >
+        <UserIcon className="mr-1 inline h-3.5 w-3.5" aria-hidden="true" />
+        {email}
+      </span>
+      <Button
+        variant="ghost"
+        size="icon"
+        onClick={handleSignOut}
+        title="Sign out"
+        aria-label="Sign out"
+        data-testid="session-signout"
+      >
+        <LogOut className="h-4 w-4" />
+      </Button>
+    </div>
+  );
+}
+
+export default SessionMenu;
